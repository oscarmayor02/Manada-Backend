      "name": "1. Auth — registro y login (3 tipos de cuenta)",
      "item": [
        {
          "name": "Registrar Dueño (Camila)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"camila@ejemplo.com\",\n  \"password\": \"123456\",\n  \"fullName\": \"Camila Rodríguez\",\n  \"phone\": \"3001234567\",\n  \"accountType\": \"DUENO\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.test(\"201 creado\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"token\", data.token);",
                  "pm.collectionVariables.set(\"userId\", data.user.id);"
                ]
              }
            }
          ]
        },
